### Programmatic API

```python
from backtest import (
    load_prices, run_backtest, compute_metrics,
    print_report, save_plots,
    walk_forward, bootstrap_score_ci, parameter_sweep,
)
from backtest.report import print_walk_forward_summary
from main import getMyPosition

prices = load_prices("prices.txt")    # shape: (50, 1250)

# --- Single evaluation pass ---
# Default scores the unseen rest after the research period (research_frac=0.5 ->
# eval [nt/2, nt)). Pass eval_start/eval_end for an explicit sub-window — e.g. to
# test on part of the unseen data while leaving the remainder untouched, or to
# reproduce the eval.py window exactly.
result  = run_backtest(prices, getMyPosition)                          # the unseen rest
result  = run_backtest(prices, getMyPosition, eval_start=500, eval_end=750)   # explicit sub-window
result  = run_backtest(prices, getMyPosition, eval_start=751, eval_end=1001)  # eval.py parity
metrics = compute_metrics(result)
print_report(result, metrics)
save_plots(result, metrics, "report.pdf")

# --- Walk-forward CV ---
folds = walk_forward(prices, getMyPosition, train_size=500, test_size=125)
print_walk_forward_summary(folds)

# --- Bootstrap CI (stationary block bootstrap — preserves PL autocorrelation) ---
ci = bootstrap_score_ci(result, n_bootstrap=2000, method="stationary")
print(f"Score: {ci['score']:.4f}  95% CI: [{ci['ci_lower']:.4f}, {ci['ci_upper']:.4f}]")
print(f"P(score > 0): {ci['prob_positive']:.1%}")

# --- Parameter sweep (with built-in in-sample / out-of-sample split) ---
def make_strategy(lookback, z_scale):
    def getMyPosition(prices):
        ...  # use lookback, z_scale
    return getMyPosition

sweep = parameter_sweep(
    prices, make_strategy,
    param_grid={"lookback": [10, 20, 40], "z_scale": [100, 200, 500]},
)
# sweep is a dict: trust OOS, not IS (see Methodology & bias section)
print("trials:", sweep["n_trials"], " IS-OOS corr:", round(sweep["is_oos_corr"], 3))
print("naive pick (best IS):", sweep["best_is"]["params"],
      "IS=%.3f OOS=%.3f" % (sweep["best_is"]["is_score"], sweep["best_is"]["oos_score"]))
print("honest winner (best OOS):", sweep["best_oos"]["params"])

# --- Access any metric directly ---
print(metrics["score"], metrics["ann_sharpe"], metrics["t_stat"], metrics["p_value"])
print(metrics["max_drawdown"], metrics["sortino"], metrics["autocorr_lag1"])
```

